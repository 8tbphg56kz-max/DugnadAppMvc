@model IEnumerable<DugnadAppMvc.Models.Beboer>

<div class="row justify-content-center">
    <div class="col-12 col-lg-12">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

    @if (User.HasAdminAccess())
    {
        <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
        <h2>Beboere</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>
            Legg til beboer
        </a>
        </div>
    }

<div class="table-responsive">

    <table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Navn</th>
            <th>E-post</th>
            <th>Leilighet</th>
                <th>Konto</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @foreach (var beboer in Model)
        {
            <tr>
                    <td>
                        @beboer.Fornavn @beboer.Etternavn
                    </td>
                <td>@beboer.Epost</td>
                    <td>
                        @beboer.Leilighet.Seksjonsnummer /
                        @beboer.Leilighet.Leilighetsnummer
                    </td>  
                    <td>
                        @if (beboer.ApplicationUser == null)
                        {
                            <span class="badge bg-secondary">
                                <i class="bi bi-person-x-fill"></i>
                                Ingen konto
                            </span>
                        }
                        else if (beboer.ApplicationUser.IsActivated)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle-fill"></i>
                                Aktiv
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-clock-history"></i>
                                Venter på aktivering
                            </span>
                        }
                    </td>
                    <td class="text-nowrap">
                        @if (User.HasAdminAccess())
                        {
                            <a asp-action="Edit"
                            asp-route-id="@beboer.Id"
                            class="btn btn-sm btn-outline-primary"
                            title="Rediger">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <a asp-action="Delete"
                            asp-route-id="@beboer.Id"
                            class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>
                                Slett
                            </a>
                        }
                    </td>
            </tr>
        }

    </tbody>
</table>
</div>
            </div>
        </div>
    </div>
</div>