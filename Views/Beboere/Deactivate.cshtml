@model DugnadAppMvc.Models.Beboer

@{
    ViewData["Title"] = "Deaktiver beboer";
}

<h2>Deaktiver beboer</h2>

<div class="alert alert-warning">
    Beboeren blir <strong>ikke slettet</strong>. Vedkommende blir kun satt som inaktiv.
</div>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-4">
                Navn
            </dt>

            <dd class="col-sm-8">
                @Model.Fornavn @Model.Etternavn
            </dd>

            <dt class="col-sm-4">
                E-post
            </dt>

            <dd class="col-sm-8">
                @Model.Epost
            </dd>

            <dt class="col-sm-4">
                Leilighet
            </dt>

            <dd class="col-sm-8">
                Seksjon @Model.Leilighet.Seksjonsnummer -
                @Model.Leilighet.Leilighetsnummer
            </dd>

        </dl>

    </div>
</div>

<form asp-action="Deactivate" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-warning">
        Deaktiver
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Avbryt
    </a>

</form>