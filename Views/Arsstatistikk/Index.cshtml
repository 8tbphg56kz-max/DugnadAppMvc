@model IEnumerable<DugnadAppMvc.Models.Arsstatistikk>

@{
    ViewData["Title"] = "Årsstatistikk";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-bar-chart me-2"></i>
            Årsstatistikk
        </h2>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Tilbake
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Det finnes ingen årsstatistikk ennå.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>År</th>
                            <th class="text-end">Aktiviteter</th>
                            <th class="text-end">Påmeldinger</th>
                            <th class="text-end">Deltakere</th>
                            <th class="text-end">Timer</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Aar</td>

                                <td class="text-end">
                                    @item.AntallAktiviteter
                                </td>

                                <td class="text-end">
                                    @item.AntallPameldinger
                                </td>

                                <td class="text-end">
                                    @item.AntallDeltakere
                                </td>

                                <td class="text-end">
                                    @item.AntallTimer.ToString("0.##")
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    }

</div>