@{
    ViewData["Title"] = "Databasebackup";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h3 class="mb-0">
                        <i class="bi bi-database-check me-2"></i>
                        Databasebackup
                    </h3>
                </div>

                <div class="card-body">

                    @if (ViewBag.Success == true)
                    {
                        <div class="alert alert-success" role="alert">
                            <h5 class="alert-heading">
                                <i class="bi bi-check-circle me-2"></i>
                                Backup gjennomført
                            </h5>

                            <p class="mb-2">
                                DugnadApp-databasen er sikkerhetskopiert.
                            </p>

                            <hr />

                            <p class="mb-1">
                                <strong>Backupinformasjon:</strong>
                            </p>

                            <div class="small">
                                <code>@ViewBag.Message</code>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger" role="alert">
                            <h5 class="alert-heading">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                Backup feilet
                            </h5>

                            <p class="mb-0">
                                Det oppstod en feil under sikkerhetskopieringen.
                            </p>

                            <hr />

                            <div class="small">
                                <code>@ViewBag.Message</code>
                            </div>
                        </div>
                    }

                    @if (ViewBag.PdfFilnavn != null)
                    {
                        <div class="mt-3">
                            <a asp-controller="ArsAvslutning"
                               asp-action="LastNedPdf"
                               asp-route-filnavn="@ViewBag.PdfFilnavn"
                               class="btn btn-primary">
                                <i class="bi bi-file-earmark-pdf me-1"></i>
                                Last ned PDF-rapport
                            </a>
                        </div>
                    }

                    <div class="mt-4">
                        <a asp-controller="Vedlikehold"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Tilbake til vedlikehold
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>