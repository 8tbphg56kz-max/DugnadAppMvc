@model IEnumerable<DugnadAppMvc.ViewModels.RapportTimerPrDugnadViewModel>

@{
    ViewData["Title"] = "Timer pr. dugnad";
}

<div class="container" style="max-width: 1100px;">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Timer pr. dugnad</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        Tilbake
    </a>
</div>
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white"> Rapport </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Dato</th>
                    <th>Dugnad</th>
                    <th class="text-end">Registreringer</th>
                    <th class="text-end">Timer</th>
                    <th class="text-end">Verdi</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Dato.ToString("dd.MM.yyyy")</td>
                        <td>@item.DugnadId</td>
                        <td class="text-end">@item.AntallRegistreringer</td>
                        <td class="text-end">@item.TotaleTimer.ToString("0,0")</td>
                        <td class="text-end">@item.TotalVerdi.ToString("N0") kr</td>
                    </tr>
                }
            </tbody>

            <tfoot class="table-light fw-semibold">
                <tr>
                    <td colspan="2">Totalt</td>
                    <td class="text-end">@Model.Sum(x => x.AntallRegistreringer)</td>
                    <td class="text-end">@Model.Sum(x => x.TotaleTimer).ToString("0,0")</td>
                    <td class="text-end">@Model.Sum(x => x.TotalVerdi).ToString("N0") kr</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>`
</div>