@model IEnumerable<DugnadAppMvc.ViewModels.RapportTimerPrDugnadViewModel>

@{
    ViewData["Title"] = "Timer pr. dugnad";
}

<div class="container" style="max-width: 1100px;">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Timer pr. dugnad</h1>
    <a asp-action="Index" class="btn btn-outline-secondary mt-2">
        Tilbake
    </a>
</div>
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white"> Rapport </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead>
                <tr>
                        <th>Dato</th>
                        <th>Aktivitet</th>
                        <th>Type</th>
                        <th class="text-end">Registreringer</th>
                        <th class="text-end">Timer</th>
                        <th class="text-end">Verdi</th>>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                            <td>
                                @item.Dato.ToString("dd.MM.yyyy")
                            </td>
                        <td>@item.Dugnad</td>
                        <td>@item.Type</td>
                        <td class="text-end">@item.Registreringer</td>
                        <td class="text-end">@item.Timer.ToString("0,0")</td>
                        <td class="text-end">@item.Verdi.ToString("N0") kr</td>
                    </tr>
                }
            </tbody>

            <tfoot class="table-light fw-semibold">
                <tr>
                    <td></td>
                        <td colspan="2" class="text-end">Totalt</td>
                    <td class="text-end">@Model.Sum(x => x.Registreringer)</td>
                    <td class="text-end">@Model.Sum(x => x.Timer).ToString("0,0")</td>
                    <td class="text-end">@Model.Sum(x => x.Verdi).ToString("N0") kr</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>`
</div>