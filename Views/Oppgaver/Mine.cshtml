@model IEnumerable<DugnadAppMvc.ViewModels.OppgaveMineViewModel>

@{
    ViewData["Title"] = "Oppgaver";
}

<h2>Oppgaver</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Det finnes ingen aktive oppgaver.
    </div>
}
else
{
    <div class="row">
        @foreach (var oppgave in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100">

                    <div class="card-header d-flex justify-content-between">
                        <strong>@oppgave.Oppgave.Navn</strong>

                        @await Html.PartialAsync("Badges/_OppgavePrioritetBadge", oppgave.Oppgave.Prioritet)
                    </div>

                    <div class="card-body">

                        <p>@oppgave.Oppgave.Beskrivelse</p>

                        <dl class="row">

                            <dt class="col-5">Fra dato</dt>
                            <dd class="col-7">
                                @oppgave.Oppgave.FraDato.ToString("dd.MM.yyyy")
                            </dd>

                            <dt class="col-5">Frist</dt>
                            <dd class="col-7">
                                @oppgave.Oppgave.Frist.ToString("dd.MM.yyyy")
                            </dd>

                            <dt class="col-5">Personer</dt>
                            <dd class="col-7">
                                @oppgave.Oppgave.AntallPersoner
                            </dd>

                            <dt class="col-5">Påmeldte</dt>
                            <dd class="col-7">
                                @oppgave.Oppgave.Pameldinger.Count av @oppgave.Oppgave.AntallPersoner
                            </dd>

                        </dl>

                    </div>

                    @if (oppgave.ErPameldt)
                    {
                        <span class="badge bg-success mb-2">
                            <i class="bi bi-check-circle"></i> Du er påmeldt
                        </span>

                        <form asp-action="TrekkPameldingFraMine"
                              asp-route-id="@oppgave.Oppgave.Id"
                              method="post">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-person-dash"></i>
                                Trekk påmelding
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="MeldPaFraMine"
                              asp-route-id="@oppgave.Oppgave.Id"
                              method="post">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-person-plus"></i>
                                Meld meg på
                            </button>
                        </form>
                    }

                </div>
            </div>
        }
    </div>
}