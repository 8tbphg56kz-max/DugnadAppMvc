@model DugnadAppMvc.ViewModels.OppgaveIndexViewModel
@using DugnadAppMvc.Models.Enums

@{
    ViewData["Title"] = "Oppgaver";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h2>Oppgaver</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Ny oppgave
    </a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Oppgave</th>
            <th>Fra dato</th>
            <th>Frist</th>
            <th>Prioritet</th>
            <th>Status</th>
            <th>Personer</th>
            <th>Timer</th>
            <th>Bekreftelse</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Oppgaver)
        {
            <tr class="@(item.ErUtført ? "table-success" : "")">

                <td>
                    <strong>@item.Navn</strong>

                    @if (!string.IsNullOrWhiteSpace(item.Beskrivelse))
                    {
                        <div class="text-muted small">
                            @(item.Beskrivelse.Length > 80
                                ? item.Beskrivelse[..80] + "..."
                                : item.Beskrivelse)
                        </div>
                    }
                </td>

                <td>
                    @item.FraDato.ToString("dd.MM.yyyy")
                </td>

                <td>
                    @item.Frist.ToString("dd.MM.yyyy")
                </td>

                <td>

                    @switch (item.Prioritet)
                    {
                        case OppgavePrioritet.Høy:
                            <span class="badge bg-danger">Høy</span>
                            break;

                        case OppgavePrioritet.Normal:
                            <span class="badge bg-warning text-dark">Normal</span>
                            break;

                        default:
                            <span class="badge bg-success">Lav</span>
                            break;
                    }

                </td>

                <td>

                    @if (item.ErUtført)
                    {
                        <span class="badge bg-success">Utført</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Aktiv</span>
                    }

                </td>

                <td>
                    @item.AntallPersoner
                </td>

                <td>
                    @(item.KanRegistrereTimer ? "Ja" : "Nei")
                </td>

                <td>
                    @(item.KreverBekreftelse ? "Ja" : "Nei")
                </td>

                <td class="text-nowrap">

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Rediger
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">
                        Slett
                    </a>

                </td>

            </tr>
        }

    </tbody>
</table>