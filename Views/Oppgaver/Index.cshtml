@model DugnadAppMvc.ViewModels.OppgaveIndexViewModel
@using DugnadAppMvc.Models.Enums

@{
    ViewData["Title"] = "Oppgaver";
}

<div class="d-flex justify-content-between align-items-end mb-3 mt-3">

    <div class="d-flex align-items-end gap-4">

        <h2 class="mb-0">Oppgaver</h2>

        <form asp-action="Index" method="get" class="mb-0">

            <div class="d-flex align-items-center gap-2">
                <label asp-for="ErUtfort" class="form-label mb-0 fw-semibold">
                    Status
                </label>

                <select asp-for="ErUtfort"
                        class="form-select"
                        style="width: 220px;"
                        onchange="this.form.submit()">
                    <option value="">Alle</option>
                    <option value="false">Aktive</option>
                    <option value="true">Utførte</option>
                </select>
            </div>

        </form>

    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>
        Ny oppgave
    </a>

</div>

@if (Model.Oppgaver.Any())
{
<div class="table-responsive">

<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Oppgave</th>
            <th>Fra dato</th>
            <th>Frist</th>
            <th>Prioritet</th>
            <th>Status</th>
            <th>Påmeldt</th>
            <th>Timer</th>
            <th>Bekreftelse</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Oppgaver)
        {            
            <tr class="@(item.ErUtført ? "table-success" : "")">

                <td>
                    <strong>
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="text-decoration-none">
                            @item.Navn
                        </a>
                    </strong>

                    @if (!string.IsNullOrWhiteSpace(item.Beskrivelse))
                    {
                        <div class="text-muted small">
                            @(item.Beskrivelse.Length > 80
                                ? item.Beskrivelse[..80] + "..."
                                : item.Beskrivelse)
                        </div>
                    }
                </td>

                <td>
                    @item.FraDato.ToString("dd.MM.yyyy")
                </td>

                <td>
                    @item.Frist.ToString("dd.MM.yyyy")
                </td>

                <td>

                    @switch (item.Prioritet)
                    {
                        case OppgavePrioritet.Høy:
                            <span class="badge bg-danger">Høy</span>
                            break;

                        case OppgavePrioritet.Normal:
                            <span class="badge bg-warning text-dark">Normal</span>
                            break;

                        default:
                            <span class="badge bg-success">Lav</span>
                            break;
                    }

                </td>

                <td>

                    @if (item.ErUtført)
                    {
                        <span class="badge bg-success">Utført</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Aktiv</span>
                    }

                </td>

                <td>
                    @{
                        var antallPameldte = item.Pameldinger.Count;

                        var badgeClass =
                            antallPameldte == 0
                                ? "bg-danger"
                                : antallPameldte < item.AntallPersoner
                                    ? "bg-warning text-dark"
                                    : "bg-success";
                    }

                    <a asp-action="AdministrerPameldinger"
                       asp-route-id="@item.Id"
                       class="text-decoration-none">
                        <span class="badge @badgeClass">
                            @antallPameldte / @item.AntallPersoner
                        </span>
                    </a>
                </td>

                <td>
                    @(item.KanRegistrereTimer ? "Ja" : "Nei")
                </td>

                <td>
                    @(item.KreverBekreftelse ? "Ja" : "Nei")
                </td>

                <td class="text-nowrap">

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil"></i>
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i>
                    </a>

                </td>

            </tr>
        }

    </tbody>
</table>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-4 mt-3">
        <div class="card-body text-center py-5">

            <i class="bi bi-check2-square text-muted" style="font-size: 2.5rem;"></i>

            <h5 class="mt-3 mb-2">Ingen oppgaver</h5>

            <p class="text-muted mb-0">
                Det finnes ingen oppgaver som matcher valgt filter.
            </p>

        </div>
    </div>

}