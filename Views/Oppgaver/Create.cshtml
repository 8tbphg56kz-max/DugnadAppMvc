@model DugnadAppMvc.Models.Oppgave
@using DugnadAppMvc.Models.Enums

@{
    ViewData["Title"] = "Ny oppgave";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

                <h3 class="mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-list-task text-primary"></i>
                    Ny oppgave
                </h3>

                <p class="text-muted mb-4">
                    Opprett en ny oppgave som kan tildeles en dugnad.
                </p>

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="border rounded-4 p-4 mb-4">
                        <h5 class="fw-semibold mb-3">Generelt</h5>

                        <div class="mb-3">
                            <label asp-for="Navn" class="form-label fw-semibold"></label>
                            <input asp-for="Navn" class="form-control" />
                        </div>

                        <div class="mb-0">
                            <label asp-for="Beskrivelse" class="form-label fw-semibold"></label>
                            <textarea asp-for="Beskrivelse" class="form-control" rows="5"></textarea>
                        </div>
                    </div>

                    <div class="border rounded-4 p-4 mb-4">
                        <h5 class="fw-semibold mb-3">Planlegging</h5>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FraDato" class="form-label fw-semibold"></label>
                                <input asp-for="FraDato" type="date" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Frist" class="form-label fw-semibold"></label>
                                <input asp-for="Frist" type="date" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-0">
                            <label asp-for="AntallPersoner" class="form-label fw-semibold"></label>
                            <input asp-for="AntallPersoner" class="form-control" />
                        </div>
                    </div>

                    <div class="border rounded-4 p-4 mb-4">
                        <h5 class="fw-semibold mb-3">Status og prioritet</h5>

                        <div class="mb-3">
                            <label asp-for="Prioritet" class="form-label fw-semibold"></label>
                            <select asp-for="Prioritet" class="form-select">
                                <option value="Lav">Lav</option>
                                <option value="Middels">Middels</option>
                                <option value="Høy">Høy</option>
                            </select>
                        </div>

                        <div class="form-check">
                            <input asp-for="ErUtført" class="form-check-input" />
                            <label asp-for="ErUtført" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>
                            Lagre
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Avbryt
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}