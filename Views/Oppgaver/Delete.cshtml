@model DugnadAppMvc.Models.Oppgave

@{
    ViewData["Title"] = "Slett oppgave";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center"
                 style="width: 48px; height: 48px;">
                <i class="bi bi-trash fs-4"></i>
            </div>
            <div>
                <h1 class="h2 mb-0">Slett oppgave</h1>
                <p class="text-muted mb-0">Denne handlingen kan ikke angres.</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
               
                <div class="alert alert-warning d-flex align-items-start gap-3">
                    <i class="bi bi-exclamation-triangle-fill fs-4 mt-1"></i>
                    <div>
                        <div class="fw-semibold mb-1">Er du sikker?</div>
                        Du er i ferd med å slette oppgaven
                        <strong>@Model.Navn</strong>.
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Navn</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Navn</dd>

                    <dt class="col-sm-4 text-muted">Beskrivelse</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.Beskrivelse) ? "Ingen beskrivelse" : Model.Beskrivelse)
                    </dd>

                    <dt class="col-sm-4 text-muted">Fra dato</dt>
                    <dd class="col-sm-8">@Model.FraDato.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Frist</dt>
                    <dd class="col-sm-8">
                        @Model.Frist.ToString("dd.MM.yyyy") 
                    </dd>

                    <dt class="col-sm-4 text-muted">Antall personer</dt>
                    <dd class="col-sm-8">@Model.AntallPersoner</dd>
                </dl>

                <hr class="my-4" />

                <form asp-action="Delete" class="d-flex gap-2 flex-wrap">
                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>
                        Slett oppgave
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Tilbake
                    </a>
                </form>

            </div>
        </div>

    </div>
</div>