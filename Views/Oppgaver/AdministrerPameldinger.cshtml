@model DugnadAppMvc.ViewModels.AdministrerPameldingerViewModel

@{
    ViewData["Title"] = "Administrer påmeldinger";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
            <div class="card-body p-4">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

<h2>@Model.Oppgave.Navn</h2>

<div class="card mt-3">
    <div class="card-header">
        Påmeldte
    </div>

    <div class="card-body">

        @if (Model.Oppgave.Pameldinger.Any())
        {
            <ul class="list-group list-group-flush">

                @foreach (var pamelding in Model.Oppgave.Pameldinger)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">

                        @pamelding.Beboer.Fornavn @pamelding.Beboer.Etternavn

                        <form asp-action="MeldAvSomAdministrator" method="post">
                            <input type="hidden" name="pameldingId" value="@pamelding.Id" />
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-person-dash"></i>
                                Meld av
                            </button>
                        </form>

                    </li>
                }

            </ul>
        }
        else
        {
            <p class="text-muted mb-0">
                Ingen er påmeldt denne oppgaven.
            </p>
        }

        <hr />

        <h5>Legg til beboer</h5>

        <form asp-action="MeldPaSomAdministrator" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="oppgaveId"
                   value="@Model.Oppgave.Id" />

            <div class="row">

                <div class="col-md-6">

                    <select asp-for="ValgtBeboerId"
                            asp-items="Model.LedigeBeboere"
                            class="form-select">

                        <option value="">
                            Velg beboer...
                        </option>

                    </select>

                </div>

                <div class="col-auto">

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i>
                        Meld på
                    </button>

                </div>

            </div>

        </form>

    </div>
    </div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Tilbake
    </a>
</div>
        </div>
    </div>
</div>