@model DugnadAppMvc.ViewModels.AdministrerPameldingerViewModel

@{
    ViewData["Title"] = "Administrer påmeldinger";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-11">
            <div class="card-body p-4">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Lukk">
                    </button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

<h2>@Model.Oppgave.Navn</h2>

<div class="card mt-3">
    <div class="card-header">
        Påmeldte
    </div>

    <div class="card-body">

                    @if (Model.PameldingStatus.Any())
                    {
                        <div class="mb-2">
                            <strong>@Model.PameldingStatus.Count</strong> påmeldte
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Beboer</th>
                                        <th>Påmeldt</th>
                                        <th>Utført</th>
                                        <th>Registrert timer</th>
                                        <th>Timer</th>
                                        <th>Status</th>
                                        @if (User.HasAdminAccess())
                                        {
                                            <th></th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model.PameldingStatus)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.Navn</strong>

                                                @if (!string.IsNullOrWhiteSpace(item.Leilighetsnummer))
                                                {
                                                    <br />
                                                    <small class="text-muted">
                                                        Leil. @item.Leilighetsnummer
                                                    </small>
                                                }
                                            </td>

                                            <td>
                                                @item.PameldtDato.ToLocalTime().ToString("dd.MM.yyyy")
                                                <br />
                                                <small class="text-muted">
                                                    kl. @item.PameldtDato.ToLocalTime().ToString("HH:mm")
                                                </small>
                                            </td>

                                            <td>
                                                @if (item.ErUtfort)
                                                {
                                                    <span class="text-success">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        Ja
                                                    </span>

                                                    @if (item.UtfortDato.HasValue)
                                                    {
                                                        <br />
                                                        <small class="text-muted">
                                                            @item.UtfortDato.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                                        </small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-warning">
                                                        <i class="bi bi-clock"></i>
                                                        Ikke utført
                                                    </span>
                                                }
                                            </td>

                                            <td class="align-top">
                                                @if (item.HarRegistrertTimer)
                                                {
                                                    <span class="text-success">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        Ja
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        <i class="bi bi-dash-circle-fill"></i>
                                                        Ingen
                                                    </span>
                                                }
                                            </td>

                                            <td class="align-top">
                                                @if (item.AntallTimer.HasValue)
                                                {
                                                    @item.AntallTimer.Value.ToString("0.00")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">–</span>
                                                }
                                            </td>

                                            <td class="align-top">
                                                @if (item.Status == "Fullført")
                                                {
                                                    <span class="badge bg-success">
                                                        Fullført
                                                    </span>
                                                }
                                                else if (item.Status == "Utført")
                                                {
                                                    <span class="badge bg-info text-dark">
                                                        Utført
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Påmeldt
                                                    </span>
                                                }
                                            </td>

                                            @if (User.HasAdminAccess())
                                            {
                                                <td>
                                                    <form asp-action="MeldAvSomAdministrator"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="pameldingId"
                                                               value="@item.PameldingId" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger">
                                                            <i class="bi bi-person-dash"></i>
                                                            Meld av
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Ingen er påmeldt denne oppgaven.
                        </p>
                    }

                    @if (User.HasAdminAccess())
                    {

        <hr />

                       <h5>Legg til beboer</h5>

                        <form asp-action="MeldPaSomAdministrator" method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                            name="oppgaveId"
                            value="@Model.Oppgave.Id" />

                            <div class="row">

                                <div class="col-md-6">

                                    <select asp-for="ValgtBeboerId"
                                    asp-items="Model.LedigeBeboere"
                                    class="form-select">

                                        <option value="">
                                            Velg beboer...
                                        </option>

                                    </select>

                                </div>

                                <div class="col-auto">

                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-person-plus"></i>
                                        Meld på
                                    </button>

                                </div>

                            </div>

                        </form>
                    }
    </div>
    </div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Tilbake
    </a>
</div>
        </div>
    </div>
</div>