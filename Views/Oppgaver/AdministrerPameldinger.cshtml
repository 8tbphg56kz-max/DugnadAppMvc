@model DugnadAppMvc.Models.Oppgave

@{
    ViewData["Title"] = "Administrer påmeldinger";
}

<h2>@Model.Navn</h2>

<div class="card mt-3">
    <div class="card-header">
        Påmeldte
    </div>

    <div class="card-body">

        @if (Model.Pameldinger.Any())
        {
            <ul class="list-group list-group-flush">

                @foreach (var pamelding in Model.Pameldinger)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">

                        @pamelding.Beboer.Fornavn @pamelding.Beboer.Etternavn

                        <form asp-action="MeldAvSomAdministrator" method="post">
                            <input type="hidden" name="pameldingId" value="@pamelding.Id" />
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-person-dash"></i>
                                Meld av
                            </button>
                        </form>

                    </li>
                }

            </ul>
        }
        else
        {
            <p class="text-muted mb-0">
                Ingen er påmeldt denne oppgaven.
            </p>
        }

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Tilbake
    </a>
</div>