@model DugnadAppMvc.ViewModels.AdministrerPameldingerViewModel

@{
    ViewData["Title"] = "Administrer påmeldinger";
}

<style>
    /* Mobilvisning */
    @@media (max-width: 767.98px) {

        .pamelding-table {
            display: none;
        }

        .pamelding-card {
            display: block;
        }

        .legg-til-form .form-select {
            width: 100%;
        }

        .legg-til-form .btn {
            width: 100%;
            margin-top: 10px;
        }

        .tilbake-knapp {
            width: 100%;
        }
    }

    /* PC/nettbrett */
    @@media (min-width: 768px) {

        .pamelding-card {
            display: none;
        }
    }
</style>

<div class="row justify-content-center">
    <div class="col-12 col-xl-11">

        <div class="card-body p-4">

            <!-- Meldinger -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Lukk">
                    </button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Lukk">
                    </button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Lukk">
                    </button>
                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @TempData["Info"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Lukk">
                    </button>
                </div>
            }

            <h2>@Model.Oppgave.Navn</h2>

            <div class="card mt-3">

                <div class="card-header">
                    Påmeldte
                </div>

                <div class="card-body">

                    @if (Model.PameldingStatus.Any())
                    {
                        <div class="mb-3">
                            <strong>@Model.PameldingStatus.Count</strong> påmeldte
                        </div>

                        <!-- ================================================= -->
                        <!-- PC / NETTBRETT - TABELL -->
                        <!-- ================================================= -->

                        <div class="table-responsive pamelding-table">

                            <table class="table table-hover align-middle">

                                <thead>
                                    <tr>
                                        <th>Beboer</th>
                                        <th>Påmeldt</th>
                                        <th>Utført</th>
                                        <th>Registrert timer</th>
                                        <th>Timer</th>
                                        <th>Status</th>

                                        @if (User.HasAdminAccess())
                                        {
                                            <th></th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in Model.PameldingStatus)
                                    {
                                        <tr>

                                            <!-- Beboer -->
                                            <td>
                                                <strong>@item.Navn</strong>

                                                @if (!string.IsNullOrWhiteSpace(item.Leilighetsnummer))
                                                {
                                                    <br />
                                                    <small class="text-muted">
                                                        Leil. @item.Leilighetsnummer
                                                    </small>
                                                }
                                            </td>

                                            <!-- Påmeldt -->
                                            <td>
                                                @item.PameldtDato.ToLocalTime().ToString("dd.MM.yyyy")
                                                <br />

                                                <small class="text-muted">
                                                    kl.
                                                    @item.PameldtDato.ToLocalTime().ToString("HH:mm")
                                                </small>
                                            </td>

                                            <!-- Utført -->
                                            <td>

                                                @if (item.ErUtfort)
                                                {
                                                    <span class="text-success">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        Ja
                                                    </span>

                                                    @if (item.UtfortDato.HasValue)
                                                    {
                                                        <br />

                                                        <small class="text-muted">
                                                            @item.UtfortDato.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                                        </small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-warning">
                                                        <i class="bi bi-clock"></i>
                                                        Ikke utført
                                                    </span>
                                                }

                                            </td>

                                            <!-- Registrert timer -->
                                            <td>

                                                @if (item.HarRegistrertTimer)
                                                {
                                                    <span class="text-success">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        Ja
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        <i class="bi bi-dash-circle-fill"></i>
                                                        Ingen
                                                    </span>
                                                }

                                            </td>

                                            <!-- Timer -->
                                            <td>

                                                @if (item.AntallTimer.HasValue)
                                                {
                                                    @item.AntallTimer.Value.ToString("0.00")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">–</span>
                                                }

                                            </td>

                                            <!-- Status -->
                                            <td>

                                                @if (item.Status == "Fullført")
                                                {
                                                    <span class="badge bg-success">
                                                        Fullført
                                                    </span>
                                                }
                                                else if (item.Status == "Utført")
                                                {
                                                    <span class="badge bg-info text-dark">
                                                        Utført
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Påmeldt
                                                    </span>
                                                }

                                            </td>

                                            <!-- Meld av -->
                                            @if (User.HasAdminAccess())
                                            {
                                                <td class="text-nowrap">

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#meldAvModal"
                                                            data-pamelding-id="@item.PameldingId"
                                                            data-beboer-navn="@item.Navn">

                                                        <i class="bi bi-person-dash"></i>
                                                        Meld av

                                                    </button>

                                                </td>
                                            }

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>


                        <!-- ================================================= -->
                        <!-- MOBIL - KORTVISNING -->
                        <!-- ================================================= -->

                        <div class="pamelding-card">

                            @foreach (var item in Model.PameldingStatus)
                            {
                                <div class="card border mb-3">

                                    <div class="card-body">

                                        <!-- Beboer -->
                                        <div class="mb-3">

                                            <h5 class="mb-1">
                                                @item.Navn
                                            </h5>

                                            @if (!string.IsNullOrWhiteSpace(item.Leilighetsnummer))
                                            {
                                                <div class="text-muted small">
                                                    Leil. @item.Leilighetsnummer
                                                </div>
                                            }

                                        </div>


                                        <div class="row g-3">

                                            <!-- Påmeldt -->
                                            <div class="col-6">

                                                <div class="text-muted small">
                                                    Påmeldt
                                                </div>

                                                <div>
                                                    @item.PameldtDato.ToLocalTime().ToString("dd.MM.yyyy")

                                                    <br />

                                                    <small class="text-muted">
                                                        kl.
                                                        @item.PameldtDato.ToLocalTime().ToString("HH:mm")
                                                    </small>
                                                </div>

                                            </div>


                                            <!-- Utført -->
                                            <div class="col-6">

                                                <div class="text-muted small">
                                                    Utført
                                                </div>

                                                @if (item.ErUtfort)
                                                {
                                                    <div class="text-success">

                                                        <i class="bi bi-check-circle-fill"></i>
                                                        Ja

                                                        @if (item.UtfortDato.HasValue)
                                                        {
                                                            <br />

                                                            <small class="text-muted">
                                                                @item.UtfortDato.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                                            </small>
                                                        }

                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-warning">

                                                        <i class="bi bi-clock"></i>
                                                        Ikke utført

                                                    </div>
                                                }

                                            </div>


                                            <!-- Registrert timer -->
                                            <div class="col-6">

                                                <div class="text-muted small">
                                                    Registrert timer
                                                </div>

                                                @if (item.HarRegistrertTimer)
                                                {
                                                    <div class="text-success">

                                                        <i class="bi bi-check-circle-fill"></i>
                                                        Ja

                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted">

                                                        <i class="bi bi-dash-circle-fill"></i>
                                                        Ingen

                                                    </div>
                                                }

                                            </div>


                                            <!-- Timer -->
                                            <div class="col-6">

                                                <div class="text-muted small">
                                                    Timer
                                                </div>

                                                <div>
                                                    @if (item.AntallTimer.HasValue)
                                                    {
                                                        @item.AntallTimer.Value.ToString("0.00")
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">–</span>
                                                    }
                                                </div>

                                            </div>


                                            <!-- Status -->
                                            <div class="col-12">

                                                <div class="text-muted small mb-1">
                                                    Status
                                                </div>

                                                @if (item.Status == "Fullført")
                                                {
                                                    <span class="badge bg-success">
                                                        Fullført
                                                    </span>
                                                }
                                                else if (item.Status == "Utført")
                                                {
                                                    <span class="badge bg-info text-dark">
                                                        Utført
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Påmeldt
                                                    </span>
                                                }

                                            </div>

                                        </div>


                                        <!-- Meld av -->
                                        @if (User.HasAdminAccess())
                                        {
                                            <hr />

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger w-100"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#meldAvModal"
                                                    data-pamelding-id="@item.PameldingId"
                                                    data-beboer-navn="@item.Navn">

                                                <i class="bi bi-person-dash"></i>
                                                Meld av

                                            </button>
                                        }

                                    </div>

                                </div>
                            }

                        </div>

                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Ingen er påmeldt denne oppgaven.
                        </p>
                    }


                    <!-- ================================================= -->
                    <!-- LEGG TIL BEBOER -->
                    <!-- ================================================= -->
                    @if (User.HasAdminAccess())
                    {
                        <hr />

                        <h5>Legg til beboer</h5>

                        <form asp-action="MeldPaSomAdministrator"
                              method="post"
                              class="legg-til-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="oppgaveId"
                                   value="@Model.Oppgave.Id" />

                            <div class="row g-2">

                                <div class="col-md-6">

                                    <select asp-for="ValgtBeboerId"
                                            asp-items="Model.LedigeBeboere"
                                            class="form-select">

                                        <option value="">
                                            Velg beboer...
                                        </option>

                                    </select>

                                </div>

                            </div>

                            <div class="mt-3">

                                <label class="form-label">
                                    Begrunnelse
                                </label>

                                <textarea name="begrunnelse"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Hvorfor melder styret beboeren på oppgaven?"></textarea>

                            </div>

                            <div class="mt-3">

                                <button type="submit"
                                        class="btn btn-primary">

                                    <i class="bi bi-person-plus"></i>
                                    Meld på

                                </button>

                            </div>

                        </form>
                    }

                </div>

            </div>


            <!-- Tilbake -->
            <div class="mt-3">

                <a asp-action="Index"
                   class="btn btn-secondary tilbake-knapp">

                    <i class="bi bi-arrow-left me-1"></i>
                    Tilbake

                </a>

            </div>

        </div>

    </div>
</div>


<!-- ========================================================= -->
<!-- MODAL - MELD AV BEBOER -->
<!-- ========================================================= -->
@if (User.HasAdminAccess())
{
    <div class="modal fade"
         id="meldAvModal"
         tabindex="-1"
         aria-labelledby="meldAvModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-action="MeldAvSomAdministrator"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="meldAvModalLabel">

                            Meld av beboer

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Lukk">
                        </button>

                    </div>

                    <div class="modal-body">

                        <p>
                            Du er i ferd med å melde av:
                        </p>

                        <p class="fw-bold"
                           id="meldAvBeboerNavn">
                        </p>

                        <input type="hidden"
                               name="pameldingId"
                               id="meldAvPameldingId" />

                        <div class="mb-3">

                            <label for="meldAvBegrunnelse"
                                   class="form-label">

                                Begrunnelse

                            </label>

                            <textarea name="begrunnelse"
                                      id="meldAvBegrunnelse"
                                      class="form-control"
                                      rows="4"
                                      required
                                      placeholder="Hvorfor melder styret beboeren av oppgaven?"></textarea>

                        </div>

                        <div class="alert alert-warning mb-0">

                            <i class="bi bi-exclamation-triangle me-1"></i>

                            Avmeldingen blir registrert i endringsloggen.

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Avbryt

                        </button>

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-person-dash me-1"></i>
                            Meld av

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}


@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var meldAvModal = document.getElementById("meldAvModal");

            if (meldAvModal) {

                meldAvModal.addEventListener("show.bs.modal", function (event) {

                    var button = event.relatedTarget;

                    if (!button) {
                        return;
                    }

                    var pameldingId =
                        button.getAttribute("data-pamelding-id");

                    var beboerNavn =
                        button.getAttribute("data-beboer-navn");

                    document.getElementById("meldAvPameldingId").value =
                        pameldingId;

                    document.getElementById("meldAvBeboerNavn").textContent =
                        beboerNavn;

                    document.getElementById("meldAvBegrunnelse").value = "";

                });

            }

        });
    </script>

}