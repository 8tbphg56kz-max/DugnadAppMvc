@using DugnadAppMvc.Models.Enums
@model DugnadAppMvc.Models.Oppgave

@{
    ViewData["Title"] = "Rediger oppgave";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

                <h3 class="mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary"></i>
                    Rediger oppgave
                </h3>

                <p class="text-muted mb-4">
                    Oppdater informasjon om oppgaven.
                </p>

                <form asp-action="Edit" enctype="multipart/form-data">

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <!-- Generelt -->
                    <div class="border rounded-4 p-4 mb-4">
                        <h5 class="fw-semibold mb-3">Generelt</h5>

                        <div class="mb-3">
                            <label asp-for="Navn"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="Navn"
                                   class="form-control" />

                            <span asp-validation-for="Navn"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Beskrivelse"
                                   class="form-label fw-semibold"></label>

                            <textarea asp-for="Beskrivelse"
                                      class="form-control"
                                      rows="5"></textarea>

                            <span asp-validation-for="Beskrivelse"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Bilder -->
                        <div class="border rounded-4 p-4 mb-4">
                            <h5 class="fw-semibold mb-3">
                                <i class="bi bi-images me-1"></i>
                                Bilder
                            </h5>

                            @if (Model.Bilder != null && Model.Bilder.Any())
                            {
                                <div class="row g-3 mb-4">
                                    @foreach (var bilde in Model.Bilder)
                                    {
                                        <div class="col-6 col-md-4">
                                            <div class="position-relative">
                                                <img src="@Url.Action("Bilde", "Oppgaver", new { id = bilde.Id })"
                                                     alt="@bilde.OriginaltFilnavn"
                                                     class="img-fluid rounded-3 shadow-sm"
                                                     style="width: 100%; height: 180px; object-fit: cover;" />

                                                <form asp-action="SlettBilde"
                                                      method="post"
                                                      class="mt-2"
                                                      onsubmit="return confirm('Er du sikker på at du vil slette dette bildet?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@bilde.Id" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm w-100">
                                                        <i class="bi bi-trash me-1"></i>
                                                        Slett bilde
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <label class="form-label fw-semibold">
                                Legg til bilder
                            </label>

                            <input type="file"
                                   name="bilder"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   multiple />

                            <div class="form-text">
                                JPG, PNG eller WebP. Maks 5 MB per bilde.
                            </div>
                        </div>
                    </div>

                    <!-- Planlegging -->
                    <div class="border rounded-4 p-4 mb-4">
                        <h5 class="fw-semibold mb-3">Planlegging</h5>

                        <div class="row g-3 mb-3">

                            <div class="col-md-6">
                                <label asp-for="FraDato"
                                       class="form-label fw-semibold"></label>

                                <input asp-for="FraDato"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="FraDato"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Frist"
                                       class="form-label fw-semibold"></label>

                                <input asp-for="Frist"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="Frist"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="mb-0">
                            <label asp-for="AntallPersoner"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="AntallPersoner"
                                   class="form-control" />

                            <span asp-validation-for="AntallPersoner"
                                  class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Utførelse -->
                    <div class="border rounded-4 p-4 mb-4">
                        <h5 class="fw-semibold mb-3">Utførelse</h5>

                        <div class="form-check mb-2">
                            <input asp-for="KanRegistrereTimer"
                                   class="form-check-input" />

                            <label asp-for="KanRegistrereTimer"
                                   class="form-check-label">
                            </label>
                        </div>

                        <div class="form-check mb-2">
                            <input asp-for="KanUtføresFlereGanger"
                                   class="form-check-input" />

                            <label asp-for="KanUtføresFlereGanger"
                                   class="form-check-label">
                            </label>
                        </div>
                    </div>

                    <!-- Status og prioritet -->
                    <div class="border rounded-4 p-4 mb-4">
                        <h5 class="fw-semibold mb-3">
                            Status og prioritet
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Prioritet"
                                   class="form-label fw-semibold"></label>

                            <select asp-for="Prioritet"
                                    class="form-select">

                                <option value="Lav">Lav</option>
                                <option value="Middels">Middels</option>
                                <option value="Høy">Høy</option>

                            </select>

                            <span asp-validation-for="Prioritet"
                                  class="text-danger small"></span>
                        </div>

                        <div class="form-check">
                            <input asp-for="ErUtført"
                                   class="form-check-input" />

                            <label asp-for="ErUtført"
                                   class="form-check-label">
                            </label>
                        </div>
                    </div>

                    <!-- Knapper -->
                    <div class="d-flex gap-2 flex-wrap">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle me-1"></i>
                            Lagre
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Avbryt
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}