@using DugnadAppMvc.Models.Enums
@model DugnadAppMvc.Models.Oppgave

@{
    ViewData["Title"] = "Rediger oppgave";

    var eksisterendeAntallBilder = Model.Bilder?.Count ?? 0;
    var maksNyeBilder = Math.Max(0, 5 - eksisterendeAntallBilder);
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-body p-4">

                <h3 class="mb-2 d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary"></i>
                    Rediger oppgave
                </h3>

                <p class="text-muted mb-4">
                    Oppdater informasjon om oppgaven.
                </p>


                <!-- HOVEDSKJEMA -->
                <form asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>


                    <!-- Generelt -->
                    <div class="border rounded-4 p-4 mb-4">

                        <h5 class="fw-semibold mb-3">
                            Generelt
                        </h5>


                        <div class="mb-3">

                            <label asp-for="Navn"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Navn"
                                   class="form-control" />

                            <span asp-validation-for="Navn"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-0">

                            <label asp-for="Beskrivelse"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Beskrivelse"
                                      class="form-control"
                                      rows="5"></textarea>

                            <span asp-validation-for="Beskrivelse"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Bilder -->
                        <div class="border rounded-4 p-4 mt-4">

                            <h5 class="fw-semibold mb-3">
                                <i class="bi bi-images me-1"></i>
                                Bilder
                            </h5>


                            @if (Model.Bilder != null && Model.Bilder.Any())
                            {
                                <div class="row g-3 mb-4">

                                    @foreach (var bilde in Model.Bilder)
                                    {
                                        <div class="col-6 col-md-4">

                                            <div class="position-relative">

                                                <img src="@Url.Action("Bilde", "Oppgaver", new { id = bilde.Id })"
                                                     alt="@bilde.OriginaltFilnavn"
                                                     class="img-fluid rounded-3 shadow-sm"
                                                     style="width: 100%; height: 180px; object-fit: cover;" />


                                                <button type="submit"
                                                        form="slett-bilde-@bilde.Id"
                                                        class="btn btn-outline-danger btn-sm w-100 mt-2">

                                                    <i class="bi bi-trash me-1"></i>
                                                    Slett bilde

                                                </button>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }


                            @if (maksNyeBilder > 0)
                            {
                                <label class="form-label fw-semibold">
                                    Legg til bilder
                                </label>

                                <input type="file"
                                       id="bildeInput"
                                       class="form-control"
                                       accept="image/jpeg,image/png,image/webp"
                                       multiple />

                                <div class="form-text">

                                    JPG, PNG eller WebP.
                                    Maks 5 MB per bilde.
                                    Du kan legge til @maksNyeBilder
                                    @(maksNyeBilder == 1 ? "bilde" : "bilder") til.

                                </div>

                                <div id="valgteBilder"
                                     class="mt-3">
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">

                                    <i class="bi bi-info-circle me-1"></i>

                                    Oppgaven har allerede maksimalt 5 bilder.

                                </div>
                            }

                        </div>

                    </div>


                    <!-- Planlegging -->
                    <div class="border rounded-4 p-4 mb-4">

                        <h5 class="fw-semibold mb-3">
                            Planlegging
                        </h5>


                        <div class="row g-3 mb-3">

                            <div class="col-md-6">

                                <label asp-for="FraDato"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="FraDato"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="FraDato"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="Frist"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Frist"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="Frist"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <div class="mb-0">

                            <label asp-for="AntallPersoner"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="AntallPersoner"
                                   class="form-control" />

                            <span asp-validation-for="AntallPersoner"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>


                    <!-- Utførelse -->
                    <div class="border rounded-4 p-4 mb-4">

                        <h5 class="fw-semibold mb-3">
                            Utførelse
                        </h5>


                        <div class="form-check mb-2">

                            <input asp-for="KanRegistrereTimer"
                                   class="form-check-input" />

                            <label asp-for="KanRegistrereTimer"
                                   class="form-check-label">
                            </label>

                        </div>


                        <div class="form-check mb-2">

                            <input asp-for="KanUtføresFlereGanger"
                                   class="form-check-input" />

                            <label asp-for="KanUtføresFlereGanger"
                                   class="form-check-label">
                            </label>

                        </div>

                    </div>


                    <!-- Status og prioritet -->
                    <div class="border rounded-4 p-4 mb-4">

                        <h5 class="fw-semibold mb-3">
                            Status og prioritet
                        </h5>


                        <div class="mb-3">

                            <label asp-for="Prioritet"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Prioritet"
                                    class="form-select">

                                <option value="Lav">
                                    Lav
                                </option>

                                <option value="Middels">
                                    Middels
                                </option>

                                <option value="Høy">
                                    Høy
                                </option>

                            </select>

                            <span asp-validation-for="Prioritet"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="form-check">

                            <input asp-for="ErUtført"
                                   class="form-check-input" />

                            <label asp-for="ErUtført"
                                   class="form-check-label">
                            </label>

                        </div>

                    </div>


                    <!-- Knapper -->
                    <div class="d-flex gap-2 flex-wrap">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-circle me-1"></i>
                            Lagre

                        </button>


                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Avbryt

                        </a>

                    </div>

                </form>


                <!-- E-POSTVARSLING -->
                @{
                    var epostVarsel =
                        ViewBag.EpostVarsel
                        as DugnadAppMvc.Models.EpostVarsel;
                }

                <div class="border rounded-4 p-4 mt-4">

                    <h5 class="fw-semibold mb-3">
                        <i class="bi bi-envelope me-1"></i>
                        E-postvarsling
                    </h5>


                    @if (epostVarsel == null)
                    {
                        <p class="text-muted mb-3">
                            Det er ikke sendt e-post om denne oppgaven.
                        </p>

                        <a asp-action="BekreftEpostVarsel"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">

                            <i class="bi bi-envelope me-1"></i>
                            Send e-post til beboerne

                        </a>
                    }
                    else if (epostVarsel.Status ==
                             DugnadAppMvc.Models.EpostVarselStatus.Sendt)
                    {
                        <div class="mb-3">

                            <button type="button"
                                    class="btn btn-success"
                                    disabled>

                                <i class="bi bi-check-circle me-1"></i>
                                E-post sendt

                            </button>

                        </div>


                        <div class="small text-muted">

                            <div>
                                <strong>Sendt:</strong>
                                @epostVarsel.SendtDato?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </div>

                            <div>
                                <strong>Sendt av:</strong>
                                @epostVarsel.SendtAvBruker?.UserName
                            </div>

                            <div>
                                <strong>Mottakere:</strong>
                                @epostVarsel.Mottakere.Count
                            </div>

                        </div>
                    }
                    else if (epostVarsel.Status ==
                             DugnadAppMvc.Models.EpostVarselStatus.DelvisSendt)
                    {
                        var antallSendt =
                            epostVarsel.Mottakere.Count(m => m.Sendt);

                        var antallFeilet =
                            epostVarsel.Mottakere.Count(m => !m.Sendt);

                        <div class="mb-3">

                            <button type="button"
                                    class="btn btn-warning"
                                    disabled>

                                <i class="bi bi-exclamation-triangle me-1"></i>
                                E-post delvis sendt

                            </button>

                        </div>

                        <div class="small text-muted">

                            <div>
                                <strong>Sendt:</strong>
                                @antallSendt
                            </div>

                            <div>
                                <strong>Feilet:</strong>
                                @antallFeilet
                            </div>

                            <div>
                                <strong>Forsøkt sendt:</strong>
                                @epostVarsel.SendtDato?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </div>

                        </div>
                    }
                    else if (epostVarsel.Status ==
                             DugnadAppMvc.Models.EpostVarselStatus.Sender)
                    {
                        <div class="mb-3">

                            <button type="button"
                                    class="btn btn-secondary"
                                    disabled>

                                <i class="bi bi-hourglass-split me-1"></i>
                                E-postsending pågår

                            </button>

                        </div>

                        <div class="small text-muted">
                            E-postene behandles. Ikke start en ny utsendelse.
                        </div>
                    }

                </div>


                <!-- SKJEMA FOR SLETTING AV BILDER -->
                @if (Model.Bilder != null)
                {
                    @foreach (var bilde in Model.Bilder)
                    {
                        <form id="slett-bilde-@bilde.Id"
                              asp-action="SlettBilde"
                              method="post"
                              onsubmit="return confirm('Er du sikker på at du vil slette dette bildet?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@bilde.Id" />

                        </form>
                    }
                }

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    @if (maksNyeBilder > 0)
    {
        <script>

            const bildeInput =
                document.getElementById("bildeInput");

            const valgteBilder =
                document.getElementById("valgteBilder");

            const maksNyeBilder =
                            @maksNyeBilder;


            // Bilder som brukeren har valgt/tatt
            // i denne redigeringen.
            let bilder = [];


            bildeInput.addEventListener("change", function () {

                const nyeBilder =
                    Array.from(this.files);


                for (const bilde of nyeBilder) {

                    if (bilder.length >= maksNyeBilder) {

                        alert(
                            `Du kan legge til maksimalt ${maksNyeBilder} nye bilder.`
                        );

                        break;
                    }


                    if (bilde.size > 5 * 1024 * 1024) {

                        alert(
                            `Bildet "${bilde.name}" er større enn 5 MB.`
                        );

                        continue;
                    }


                    const tillatteTyper = [
                        "image/jpeg",
                        "image/png",
                        "image/webp"
                    ];


                    if (!tillatteTyper.includes(bilde.type)) {

                        alert(
                            `Bildet "${bilde.name}" har en filtype som ikke er tillatt.`
                        );

                        continue;
                    }


                    bilder.push(bilde);

                }


                visValgteBilder();


                // Viktig på iPhone.
                // Input-feltet tømmes slik at kameraet
                // kan åpnes på nytt og ta neste bilde.
                this.value = "";

            });


            function visValgteBilder() {

                valgteBilder.innerHTML = "";


                bilder.forEach((bilde, index) => {

                    const rad =
                        document.createElement("div");


                    rad.className =
                        "d-flex align-items-center justify-content-between border rounded-3 p-2 mb-2";


                    rad.innerHTML = `

                                    <div class="text-truncate">

                                        <i class="bi bi-image me-2"></i>

                                        <span>
                                            ${bilde.name}
                                        </span>

                                    </div>


                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger ms-2"
                                            onclick="fjernBilde(${index})"
                                            title="Fjern bilde">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                `;


                    valgteBilder.appendChild(rad);

                });

            }


            function fjernBilde(index) {

                bilder.splice(index, 1);

                visValgteBilder();

            }


            // Før skjemaet sendes:
            // legg alle bildene vi har samlet
            // tilbake i input-feltet.
            document
                            .querySelector("form[asp-action='Edit']")
                .addEventListener("submit", function () {

                                const dataTransfer =
                        new DataTransfer();


                                bilder.forEach(function (bilde) {

                                    dataTransfer.items.add(bilde);

                                });


                                bildeInput.files =
                        dataTransfer.files;

                                bildeInput.name =
                        "bilder";

                            });

        </script>
    }

}