@using Microsoft.AspNetCore.Identity
@using DugnadAppMvc.Models
@using DugnadAppMvc.Infrastructure.Identity
@using DugnadAppMvc.Services
@inject UserManager<ApplicationUser> UserManager
@inject SameieService SameieService

@{
    var innstillinger = await SameieService.GetInnstillingerAsync();
}

<!DOCTYPE html>
<html lang="nb-NO">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DugnadApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DugnadAppMvc.styles.css" asp-append-version="true" />    
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <i class="bi bi-house-door me-3 brand-icon"></i>

                    <div class="brand-text">
                        <div class="brand-sameie">
                            @innstillinger?.SameieNavn
                        </div>

                        <div class="brand-app">
                            Dugnad<span>App</span>
                        </div>
                    </div>

                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (User.HasAdminAccess())
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Dashboard
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Min side
                                </a>
                            </li>
                        }

                        @if (User.HasBoardAccess())
                        { 
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   id="boardDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-people-fill me-1"></i>
                                    Styre
                                </a>

                                <ul class="dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Administrasjon"
                                           asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Oversikt
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Dugnader"
                                           asp-action="Index">
                                            <i class="bi bi-calendar-event me-2"></i>
                                            Fellesdugnader
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Oppgaver"
                                           asp-action="Index">
                                            <i class="bi bi-card-checklist me-2"></i>
                                            Oppgaver
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="BoardMessages"
                                           asp-action="Index">
                                            <i class="bi bi-megaphone me-2"></i>
                                            Styremeldinger
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Beboere"
                                           asp-action="Index">
                                            <i class="bi bi-people me-2"></i>
                                            Beboere
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Leiligheter"
                                           asp-action="Index">
                                            <i class="bi bi-buildings me-2"></i>
                                            Leiligheter
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="AdminTimeforinger"
                                           asp-action="Index">
                                            <i class="bi bi-clock-history me-2"></i>
                                            Timeføringer
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="AdminRapporter"
                                           asp-action="Index">
                                            <i class="bi bi-bar-chart me-2"></i>
                                            Rapporter
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    @if (User.HasBoardAccess())
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="AdminUsers"
                                               asp-action="Index">
                                                <i class="bi bi-person-gear me-2"></i>
                                                Brukere
                                            </a>
                                        </li>                                       
                                    

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Innstillinger"
                                           asp-action="Index">
                                            <i class="bi bi-gear me-2"></i>
                                            Innstillinger
                                        </a>
                                    </li>
                                    }

                                    @if (User.HasBoardAccess())
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                                asp-controller="Vedlikehold"
                                               asp-action="Index">
                                                <i class="bi bi-tools me-2"></i>Vedlikehold
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }

                    </ul>
                    <ul class="navbar-nav ms-4">

                        @{
                            ApplicationUser? currentUser = null;

                            if (User.Identity?.IsAuthenticated == true)
                            {
                                currentUser = await UserManager.GetUserAsync(User);
                            }
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> Knut
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="dropdown-item">
                                     Min konto
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li> 
                                        <a class="dropdown-item text-danger"
                                           asp-controller="Account"
                                           asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-1"></i>
                                            Logg ut
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Logg inn
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-2 px-md-4">
        <div class="app-content">
            <main role="main" class="pb-3">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @TempData["Info"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()

            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center">
            &copy; @DateTime.Now.Year DugnadApp
            &nbsp;|&nbsp;
            <a asp-controller="Information" asp-action="Om" class="text-decoration-none">
                <i class="bi bi-info-circle me-1"></i>Om DugnadApp
            </a>
            &nbsp;|&nbsp;
            <a asp-controller="Information" asp-action="Personvern" class="text-decoration-none">
                <i class="bi bi-shield-lock me-1"></i>Personvern
            </a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
