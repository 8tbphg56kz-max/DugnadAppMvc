@model DugnadAppMvc.ViewModels.DugnadstimeViewModel

<div class="mb-4">
    <h2 class="mb-1">
        <i class="bi bi-clock-history me-2"></i>
        Registrer dugnadstimer
    </h2>

    <p class="text-muted">
        Registrer timer du har brukt på en dugnad.
    </p>
</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="DugnadId" class="form-label"></label>

                <select asp-for="DugnadId"
                        asp-items="Model.Dugnader"
                        class="form-select">

                    <option value="">Velg dugnad...</option>

                </select>

                <span asp-validation-for="DugnadId"
                      class="text-danger"></span>
            </div>

    <div class="mb-3">
        <label class="form-label">Dato</label>
                <input asp-for="Dato" class="form-control" />
                <span asp-validation-for="Dato" class="text-danger"></span>
    </div>

    <div class="mb-3">
                <select asp-for="Timer"
                        asp-items="Model.TimerAlternativer"
                        class="form-select">
                </select>

                <span asp-validation-for="Timer"
                      class="text-danger"></span>
    </div>    

    <div class="mb-3">
        <label class="form-label">Kommentar</label>
                <textarea asp-for="Kommentar"
                          class="form-control"
                          rows="3"></textarea>
    </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle me-1"></i>
                    Lagre

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Avbryt

                </a>

            </div>
</form>
</div>
</div>