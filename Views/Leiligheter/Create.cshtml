@model DugnadAppMvc.Models.Leilighet

@{
    ViewData["Title"] = "Ny leilighet";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

                <h3 class="mb-4">
                    <i class="bi bi-house-add text-primary me-2"></i>
                    Ny leilighet
                </h3>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>                    

                    <div class="mb-4">
                        <label asp-for="Leilighetsnummer" class="form-label"></label>
                        <input asp-for="Leilighetsnummer" class="form-control" />
                        <span asp-validation-for="Leilighetsnummer" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>
                            Lagre
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Avbryt
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}