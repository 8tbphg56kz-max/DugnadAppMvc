@model DugnadAppMvc.Models.Leilighet

@{
    ViewData["Title"] = "Rediger leilighet";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

<h2>Rediger leilighet</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />  

    <div class="mb-3">
        <label asp-for="Leilighetsnummer" class="form-label felt-overskrift"></label>
        <input asp-for="Leilighetsnummer" class="form-control" />
        <span asp-validation-for="Leilighetsnummer" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Lagre
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Avbryt
    </a>

</form>
</div>
 </div>
 </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}