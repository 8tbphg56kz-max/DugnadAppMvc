@model DugnadAppMvc.Models.Leilighet

@{
    ViewData["Title"] = "Slett leilighet";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

<h2>Slett leilighet</h2>

@if (Model.Beboere.Any())
{
    <div class="alert alert-warning">
        Denne leiligheten kan ikke slettes fordi den har registrerte beboere.
    </div>
}

<div class="card">
    <div class="card-body">

        <dl class="row">   
            <dt class="col-sm-4">
                Leilighetsnummer
            </dt>
            <dd class="col-sm-8">
                @Model.Leilighetsnummer
            </dd>

            <dt class="col-sm-4">
                Antall beboere
            </dt>
            <dd class="col-sm-8">
                @Model.Beboere.Count
            </dd>
        </dl>

    </div>
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    @if (!Model.Beboere.Any())
    {
        <button type="submit" class="btn btn-danger mt-2">
            Slett
        </button>
    }

    <a asp-action="Index" class="btn btn-secondary mt-2">
        Tilbake
    </a>

</form>
</div>
        </div>
    </div>
</div>