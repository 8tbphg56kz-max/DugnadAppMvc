@model BoardMessage

@{
    ViewData["Title"] = "Slett styremelding";
}

<h1 class="mb-4">Slett styremelding</h1>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    Er du sikker på at du vil slette denne styremeldingen? Handlingen kan ikke angres.
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="mb-3">
            <strong>Tittel</strong><br />
            @Model.Tittel
        </div>

        <div class="mb-3">
            <strong>Innhold</strong><br />
            @Model.Innhold
        </div>

        <div class="mb-4">
            <strong>Publisert</strong><br />
            @Model.PublisertDato.ToString("dd.MM.yyyy")
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Slett
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Avbryt
            </a>
        </form>

    </div>
</div>