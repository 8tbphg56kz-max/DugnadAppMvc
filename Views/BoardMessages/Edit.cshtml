@model BoardMessage

@{
    ViewData["Title"] = "Rediger styremelding";
}

<h1>Rediger styremelding</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Tittel" class="control-label"></label>
                <input asp-for="Tittel" class="form-control" />
                <span asp-validation-for="Tittel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Innhold" class="control-label"></label>
                <textarea asp-for="Innhold"
                          class="form-control"
                          rows="6"></textarea>
            </div>
            <div class="form-group">
                <label asp-for="PublisertDato" class="control-label"></label>
                <input asp-for="PublisertDato" class="form-control" />
                <span asp-validation-for="PublisertDato" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>
                    Lagre endringer
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Tilbake
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
