@model BoardMessage

@{
    ViewData["Title"] = "Ny styremelding";
}

<div class="row justify-content-center"> <div class="col-12 col-md-10 col-lg-8">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <h3 class="mb-4">
                <i class="bi bi-megaphone text-primary me-2"></i>
                Ny styremelding
            </h3>

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Tittel" class="form-label fw-semibold">Tittel</label>
                    <input asp-for="Tittel" class="form-control" />
                    <span asp-validation-for="Tittel" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Innhold" class="form-label fw-semibold">Innhold</label>
                        <textarea asp-for="Innhold"
                              class="form-control"
                              rows="8"></textarea>
                        <span asp-validation-for="Innhold" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Lagre
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Tilbake
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}`