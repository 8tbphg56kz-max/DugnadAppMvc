@model BoardMessage

@{
    ViewData["Title"] = "Ny styremelding";
}

<h1>Ny styremelding</h1>

<hr />

<h4>BoardMessage</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Tittel" class="control-label"></label>
                <input asp-for="Tittel" class="form-control" />
                <span asp-validation-for="Tittel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Innhold" class="control-label"></label>
                <textarea asp-for="Innhold" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Innhold" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PublisertDato" class="control-label"></label>
                <input asp-for="PublisertDato" class="form-control" />
                <span asp-validation-for="PublisertDato" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>
                    Lagre
                </button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Tilbake
    </a>
</div>
