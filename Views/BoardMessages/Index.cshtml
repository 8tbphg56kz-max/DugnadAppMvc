@model IEnumerable<BoardMessage>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tittel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Innhold)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PublisertDato)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Tittel)
            </td>
            <td>
                @Html.DisplayFor(model => item.Innhold)
            </td>
            <td>
                @Html.DisplayFor(model => item.PublisertDato)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
