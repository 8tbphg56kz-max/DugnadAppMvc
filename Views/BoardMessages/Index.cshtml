@model IEnumerable<BoardMessage>

@{
    ViewData["Title"] = "Styremeldinger";
}

<h1>Styremeldinger</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>
        Ny melding
    </a>
</p>
<table class="table table-striped table-hover align-top">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tittel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Innhold)
            </th>
            <th>
                Publisert
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td class="align-top">
                    @item.Tittel
                </td>
                <td class="align-top" style="white-space: pre-line;">@item.Innhold</td>
                <td class="align-top">
                    @item.PublisertDato.ToString("dd.MM.yy")
                </td>
                <td class="text-nowrap">
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil"></i> Rediger
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i> Slett
                    </a>
                </td>
        </tr>
}
    </tbody>
</table>
