@using DugnadAppMvc.Helpers
@model IEnumerable<BoardMessage>

@{
    ViewData["Title"] = "Styremeldinger";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h2>Styremeldinger</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>
        Ny melding
    </a>
</div>

@if (Model.Any())
{
<div class="table-responsive">

<table class="table table-striped table-hover align-top">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tittel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Innhold)
            </th>
            <th>
                Publisert
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td class="align-top">
                    @item.Tittel
                </td>
                        <td class="align-top" style="white-space: pre-line;">@Html.Raw(TextHelper.FormaterLinjeskift(item.Innhold))</td>
                <td class="align-top">
                    @item.PublisertDato.ToString("dd.MM.yy")
                </td>
                <td class="text-nowrap">
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil"></i> Rediger
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i> Slett
                    </a>
                </td>
        </tr>
}
    </tbody>
</table>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-4 mt-3">
        <div class="card-body text-center py-5">

            <i class="bi bi-megaphone text-muted" style="font-size: 2.5rem;"></i>

            <h5 class="mt-3 mb-2">Ingen styremeldinger</h5>

            <p class="text-muted mb-0">
                Det er ingen styremeldinger publisert ennå.
            </p>

        </div>
    </div>

}
