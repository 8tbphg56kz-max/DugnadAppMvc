@model IEnumerable<DugnadAppMvc.ViewModels.AdminUsers.UserListViewModel>

@{
    ViewData["Title"] = "Styremedlemmer";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-12">

        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
                    <h2>Styremedlemmer</h2>

                    <a asp-action="Add" class="btn btn-primary">
                        <i class="bi bi-shield-plus me-1"></i>
                        Legg til tilgang
                    </a>
                </div>

                @if (!Model.Any())
                {
                    <div class="alert alert-info">
                        Det er ingen administratorer registrert.
                    </div>
                }
                else
                {
                    <!-- PC / nettbrett -->
                    <div class="table-responsive d-none d-md-block">

                        <table class="table table-striped align-middle">

                            <thead>
                                <tr>
                                    <th class="fw-semibold">Navn</th>
                                    <th class="fw-semibold">E-post</th>
                                    <th class="fw-semibold">Tilganger</th>
                                    <th class="fw-semibold text-nowrap">Handling</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var user in Model)
                                {
                                    <tr>

                                        <td class="text-nowrap">
                                            @user.Navn
                                        </td>

                                        <td>
                                            @user.Epost
                                        </td>

                                        <td>
                                            <span class="badge bg-primary text-nowrap">
                                                @user.Rolle
                                            </span>
                                        </td>

                                        <td class="text-nowrap">

                                            <div class="d-flex flex-wrap gap-1">

                                                <a asp-action="Edit"
                                                   asp-route-id="@user.Id"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Rediger">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                @if (user.Epost != "admin@dugnadapp.no")
                                                {
                                                    <form asp-action="FjernTilgang"
                                                          method="post"
                                                          class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="userId"
                                                               value="@user.Id" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                onclick="return confirm('Fjerne styretilgangen for @user.Navn?');">
                                                            <i class="bi bi-person-dash me-1"></i>
                                                            Gjør til beboer
                                                        </button>

                                                    </form>
                                                }

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- Mobil -->
                    <div class="d-md-none">

                        @foreach (var user in Model)
                        {
                            <div class="card border rounded-3 mb-3">

                                <div class="card-body">

                                    <div class="mb-2">
                                        <div class="fw-semibold">
                                            @user.Navn
                                        </div>
                                    </div>

                                    <div class="mb-2">
                                        <small class="text-muted d-block">
                                            E-post
                                        </small>

                                        <div>
                                            @user.Epost
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">
                                            Tilganger
                                        </small>

                                        <span class="badge bg-primary">
                                            @user.Rolle
                                        </span>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil me-1"></i>
                                            Rediger
                                        </a>

                                        @if (user.Epost != "admin@dugnadapp.no")
                                        {
                                            <form asp-action="FjernTilgang"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="userId"
                                                       value="@user.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Fjerne styretilgangen for @user.Navn?');">
                                                    <i class="bi bi-person-dash me-1"></i>
                                                    Gjør til beboer
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>
</div>