@model DugnadAppMvc.ViewModels.AdminUsers.EditUserRoleViewModel

@{
    ViewData["Title"] = "Rediger bruker";
}

<h2>Rediger bruker</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label class="form-label">Navn</label>
    <input class="form-control" value="@Model.Navn" readonly />
</div>

<div class="mb-3">
    <label class="form-label">E-post</label>
    <input class="form-control" value="@Model.Epost" readonly />
</div>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="SelectedRole" class="form-label"></label>
        <select asp-for="SelectedRole"
                asp-items="Model.Roles"
                class="form-select">
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Lagre
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Avbryt
    </a>
</form>