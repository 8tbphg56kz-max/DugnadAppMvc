@using DugnadAppMvc.ViewModels 
@using Microsoft.AspNetCore.Mvc.Rendering 
@model LeggTilTilgangViewModel


@{
    ViewData["Title"] = "Legg til tilgang";
}

<div class="row justify-content-center"> <div class="col-12 col-md-8 col-lg-6">
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-4">

            <h3 class="mb-4">
                <i class="bi bi-shield-plus text-primary me-2"></i>
                Legg til styretilgang
            </h3>

            <form asp-action="GiTilgang" method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="UserId" class="form-label fw-semibold">
                        Velg beboer
                    </label>

                        <select asp-for="UserId" 
                                asp-items="(IEnumerable<SelectListItem>)ViewBag.Beboere" class="form-select"> 
                                    <option value="">Velg beboer...</option> 
                        </select>
                </div>

                <div class="mb-4">
                    <label asp-for="Rolle" class="form-label fw-semibold">
                        Velg tilgang
                    </label>

                        <select asp-for="Rolle" class="form-select">
                            <option value="@IdentityRoles.Styremedlem">Styremedlem</option>
                            <option value="@IdentityRoles.Administrator">Administrator</option>

                            @if (User.IsInRole(IdentityRoles.SystemAdministrator))
                            {
                                <option value="@IdentityRoles.SystemAdministrator">Systemadministrator</option>
                            }
                        </select>
                </div>

                <button class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>
                    Gi tilgang
                </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Avbryt
                    </a>

            </form>

        </div>
    </div>
</div>
</div>