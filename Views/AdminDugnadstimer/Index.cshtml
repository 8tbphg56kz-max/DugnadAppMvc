@model IEnumerable<DugnadAppMvc.ViewModels.AdminDugnadstimeViewModel>

@{
    ViewData["Title"] = "Registrerte dugnadstimer";
}

<h2 class="mb-4">Registrerte dugnadstimer</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Registrer dugnadstime
    </a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Registrert</th>
            <th>Dugnad</th>
            <th>Beboer</th>
            <th class="text-end">Timer</th>
            <th>Kommentar</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Registrert.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.Dugnad</td>
                <td>@item.Beboer</td>
                <td class="text-end">@item.Timer</td>
                <td>@item.Kommentar</td>

                <td class="text-end">

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Rediger
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">
                        Slett
                    </a>

                </td>
            </tr>
        }

    </tbody>

</table>