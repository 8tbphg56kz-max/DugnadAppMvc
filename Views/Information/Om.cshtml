@{
    ViewData["Title"] = "Om DugnadApp";
}

<div class="container py-4">

    <div class="card shadow-sm">
        <div class="card-body">

            <h2 class="card-title mb-4">
                <i class="bi bi-info-circle me-2"></i>
                Om DugnadApp
            </h2>

            <p>
                DugnadApp er utviklet for å gjøre planlegging og gjennomføring av
                dugnader enklere for borettslag og sameier.
            </p>

            <p>
                Med DugnadApp kan beboere blant annet:
            </p>

            <ul>
                <li>Melde seg på dugnadsoppgaver.</li>
                <li>Registrere dugnadstimer.</li>
                <li>Holde oversikt over egne timer.</li>
                <li>Se informasjon fra styret.</li>
                <li>Følge kommende fellesdugnader.</li>
            </ul>

            <p class="mt-4">
                Målet med DugnadApp er å gjøre dugnadsarbeidet enklere,
                mer oversiktlig og mer rettferdig for både beboere og styret.
            </p>

        </div>
    </div>

</div>