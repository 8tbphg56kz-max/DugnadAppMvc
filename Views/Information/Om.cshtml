@{
    ViewData["Title"] = "Om DugnadApp";
}

<div class="container-fluid px-2 px-md-4">

    <div class="row justify-content-center mt-4 mt-md-5">
        <div class="col-12 col-md-10 col-lg-8">

            <div class="card shadow-sm">
                <div class="card-body p-3 p-md-5">

                    <h1 class="h3 mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        Om DugnadApp
                    </h1>

                    <p>
                        DugnadApp er utviklet for å gjøre planlegging,
                        gjennomføring og registrering av dugnader enklere i sameiet.
                    </p>

                    <p>
                        Med DugnadApp kan beboere blant annet:
                    </p>

                    <ul class="mb-0">
                        <li>Melde seg på dugnadsoppgaver.</li>
                        <li>Registrere dugnadstimer.</li>
                        <li>Holde oversikt over egne timer.</li>
                        <li>Se informasjon fra styret.</li>
                        <li>Følge kommende fellesdugnader.</li>
                    </ul>

                </div>
            </div>

        </div>
    </div>

</div>