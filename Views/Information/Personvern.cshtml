@{
    ViewData["Title"] = "Personvern";
}

<div class="container-fluid px-2 px-md-4">

    <div class="row justify-content-center mt-4 mt-md-5">
        <div class="col-12 col-md-10 col-lg-8">

            <div class="card shadow-sm">
                <div class="card-body p-3 p-md-5">

                    <h1 class="h3 h-md-2 mb-4">
                        <i class="bi bi-shield-lock me-2"></i>
                        Personvern
                    </h1>

                    <p>
                        DugnadApp brukes til å administrere dugnadsarbeid i sameiet.
                        Vi legger vekt på at personopplysninger skal behandles på en
                        trygg og oversiktlig måte.
                    </p>

                    <h5 class="mt-4 mb-3">
                        Hvilke opplysninger lagres?
                    </h5>

                    <p>
                        For å kunne bruke DugnadApp lagres blant annet:
                    </p>

                    <ul class="mb-4">
                        <li>Navn</li>
                        <li>E-postadresse</li>
                        <li>Leilighet</li>
                        <li>Brukerrolle</li>
                        <li>Påmeldinger til dugnader og oppgaver</li>
                        <li>Registrerte timeføringer</li>
                    </ul>

                    <h5 class="mt-4 mb-3">
                        Hvorfor lagres opplysningene?
                    </h5>

                    <p>
                        Opplysningene brukes til å administrere dugnader og oppgaver,
                        registrere timer og gi beboerne oversikt over egne aktiviteter.
                    </p>

                    <p>
                        E-postadressen brukes blant annet til innlogging og til å
                        sende nødvendig informasjon om brukerens konto.
                    </p>

                    <h5 class="mt-4 mb-3">
                        Hvem har tilgang?
                    </h5>

                    <p>
                        Du kan se dine egne opplysninger og aktiviteter.
                    </p>

                    <p>
                        Styret og administratorer kan få tilgang til opplysninger
                        som er nødvendige for å administrere dugnader, oppgaver
                        og timeføringer.
                    </p>

                    <p>
                        Tilgang til systemets tekniske og administrative funksjoner
                        er begrenset til personer som har behov for dette.
                    </p>

                    <h5 class="mt-4 mb-3">
                        Hvor lenge lagres opplysningene?
                    </h5>

                    <p>
                        Registrerte dugnadstimer slettes ved avslutningen av dugnadsåret.
                    </p>

                    <p>
                        Øvrige opplysninger lagres så lenge de er nødvendige for
                        administrasjonen av sameiet.
                    </p>

                    <h5 class="mt-4 mb-3">
                        Hvordan beskytter vi opplysningene?
                    </h5>

                    <p>
                        DugnadApp bruker sikker innlogging og kryptert forbindelse
                        (HTTPS).
                    </p>

                    <p>
                        Passordet ditt lagres på en sikker måte, og ingen i styret
                        kan se passordet ditt.
                    </p>

                    <p>
                        Tilgang til tekniske innstillinger og serveren er begrenset
                        til systemadministrator.
                    </p>

                    <h5 class="mt-4 mb-3">
                        Kontakt
                    </h5>

                    <p class="mb-0">
                        Har du spørsmål om hvordan personopplysningene dine behandles,
                        eller ønsker du å vite hvilke opplysninger som er registrert
                        om deg, kan du ta kontakt med styret.
                    </p>

                </div>
            </div>

        </div>
    </div>

</div>