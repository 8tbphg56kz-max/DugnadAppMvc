@model DugnadAppMvc.ViewModels.AdminTimeforingerIndexViewModel

@{
    ViewData["Title"] = "Registrerte timeføringer";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h2 class="mb-0">Registrerte timeføringer</h2>
     @if (User.HasAdminAccess())
                        {
    <a asp-action="Create" class="btn btn-success">
        Registrer timeføring
    </a>
                        }
</div>

<div class="card shadow-sm">
    <div class="card-body px-4">
<form asp-action="Index" method="get" class="row g-3 mb-3">

    <div class="col-md-3">
        <label asp-for="BeboerId" class="form-label fw-semibold text-primary">Beboer</label>

        <select asp-for="BeboerId"
                asp-items="Model.Beboere"
                class="form-select"
                onchange="this.form.submit()">

            <option value="">Alle beboere</option>

        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="LeilighetId" class="form-label fw-semibold text-primary">Leilighet</label>

        <select asp-for="LeilighetId"
                asp-items="Model.Leiligheter"
                class="form-select"
                onchange="this.form.submit()">

            <option value="">Alle leiligheter</option>

        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="Aktivitet" class="form-label fw-semibold text-primary">Aktivitet</label>

                <select asp-for="Aktivitet"
                        asp-items="Model.Aktiviteter"
                class="form-select"
                onchange="this.form.submit()">

            <option value="">Alle timeføringer</option>

        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <a asp-action="Index" class="btn btn-primary w-100">
            Vis alle
        </a>
    </div>
</form>
</div>
</div>

<div class="mb-4">

    @if (Model.Dugnadstimer.Any())
    { 
   <div class="table-responsive">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Registrert</th>
            <th>Aktivitet</th>
            <th>Beboer</th>
            <th class="text-end">Timer</th>
            <th>Kommentar</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Dugnadstimer)
        {
            <tr>
                <td>@item.Registrert.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.Aktivitet</td>
                <td>@item.Beboer</td>
                <td class="text-end">@item.Timer</td>
                <td>@item.Kommentar</td>

                <td class="text-end">
                        @if (User.HasAdminAccess())
                        {
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Rediger
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">
                        Slett
                    </a>
                        }
                </td>
            </tr>
        }

    </tbody>

</table>
</div>
 } 
else 
{    
<div class="alert alert-light border d-flex align-items-center gap-2 mt-3">
 <i class="bi bi-clock-history text-secondary fs-5"></i>
 <span>Ingen registrerte timeføringer for valgt filter.</span> 
</div> 
}
</div>
