@model DugnadAppMvc.ViewModels.AdminCreateTimeforingViewModel

<div class="mb-4">
    <h2 class="mb-1">
        <i class="bi bi-clock-history me-2"></i>
        Registrer timeføring
    </h2>

    <p class="text-muted">
        Registrer timeføring på vegne av en beboer.
    </p>
</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Aktivitet" class="form-label"></label>

                <select asp-for="Aktivitet"
                        asp-items="Model.Aktiviteter"
                        class="form-select">

                    <option value="">Velg aktivitet...</option>

                </select>

                <span asp-validation-for="Aktivitet"
                      class="text-danger"></span>
            </div>    

            <div class="mb-3">
                <label asp-for="BeboerId" class="form-label"></label>
                <select asp-for="BeboerId"
                        asp-items="Model.Beboere"
                        class="form-select">
                    <option value="">Velg beboer...</option>
                </select>
                <span asp-validation-for="BeboerId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Timer" class="form-label"></label>

                <select asp-for="Timer"
                        asp-items="Model.TimerAlternativer"
                        class="form-select">
                </select>

                <span asp-validation-for="Timer"
                      class="text-danger"></span>
            </div>

    <div class="mb-3">
                <label asp-for="Kommentar" class="form-label"></label>
                <textarea asp-for="Kommentar"
                          class="form-control"
                          rows="3"></textarea>
    </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle me-1"></i>
                    Lagre

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Avbryt

                </a>

            </div>
</form>
</div>
</div>