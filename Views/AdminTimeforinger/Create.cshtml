@model DugnadAppMvc.ViewModels.AdminCreateTimeforingViewModel
@{
    ViewData["Title"] = "Registrer timeføring";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

                <h3 class="mb-2">
                    <i class="bi bi-clock-history text-primary me-2"></i>
                    Registrer timeføring
                </h3>

                <p class="text-muted mb-4">
                    Registrer timeføring på vegne av en beboer.
                </p>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Aktivitet" class="form-label">Aktivitet</label>
                        <select asp-for="Aktivitet"
                                class="form-select"
                                asp-items="ViewBag.AktivitetId">
                            <option value="">Velg aktivitet...</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BeboerId" class="form-label">Beboer</label>
                        <select asp-for="BeboerId"
                                class="form-select"
                                asp-items="ViewBag.BeboerId">
                            <option value="">Velg beboer...</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Timer" class="form-label">Timer</label>
                        <input asp-for="Timer"
                               type="number"
                               step="0.5"
                               class="form-control" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Kommentar" class="form-label">Kommentar</label>
                        <textarea asp-for="Kommentar"
                                  class="form-control"
                                  rows="4"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>
                            Lagre
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Avbryt
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}