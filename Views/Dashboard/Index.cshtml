@model DugnadAppMvc.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Min side";
}

<div class="row mb-4">

    <div class="col-12">

        <div class="card shadow-sm border-0 mb-4 welcome-card">
            <div class="card-body py-2 text-center text-md-start">

                <h2 class="mb-2">
                    Hei @Model.FirstName 👋
                </h2>

                <p class="text-muted mb-0">
                    Velkommen tilbake til DugnadApp.
                    Her finner du en oversikt over dugnader, registrerte timer
                    og beskjeder fra styret.
                </p>

            </div>
        </div>

    </div>

</div>

<div class="row g-4">

    <!-- Aktuelle dugnader -->
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">

                <h5>
                    <i class="bi bi-list-check text-primary me-2"></i>
                    Aktuelle dugnader
                </h5>

                <hr />

                <p class="text-muted">
                    Ingen åpne dugnader akkurat nå.
                </p>

            </div>
        </div>
    </div>

    <!-- Fellesdugnad -->
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">

                <h5>
                    <i class="bi bi-tree text-success me-2"></i>
                    Fellesdugnad
                </h5>

                <hr />

                Ingen planlagt akkurat nå.

            </div>
        </div>
    </div>

    <!-- Mine dugnadstimer -->
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">

                <h5>
                    <i class="bi bi-clock-history text-success me-2"></i>
                    Mine dugnadstimer
                </h5>

                <hr />

                <h1 class="display-4 text-primary">
                    @Model.TotalHours
                </h1>

                <p class="text-muted">
                    Registrerte timer i år
                </p>

                <div class="d-grid gap-2 d-md-flex">
                    <a asp-controller="Dugnadstimer"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        <i class="bi bi-clock-history me-1"></i>
                        Vis historikk
                    </a>

                    <a asp-controller="Dugnadstimer"
                       asp-action="Create"
                       class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        Registrer timer
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Beskjed fra styret -->
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body">

                <h5>
                    <i class="bi bi-megaphone text-warning me-2"></i>
                    Beskjed fra styret
                </h5>

                <hr />

                <p class="text-muted">
                    Ingen nye beskjeder.
                </p>

            </div>
        </div>
    </div>  

</div>