@using DugnadAppMvc.Services
@model DugnadAppMvc.ViewModels.DashboardViewModel
@inject SameieService SameieService
@{
    ViewData["Title"] = "Min side";
}

<div class="dashboard-container">
<div class="row mb-4">

    <div class="col-12">

        <div class="card shadow-sm border-0 mb-4 welcome-card">
            <div class="card-body py-2 text-center text-md-start">

                <h2 class="mb-2">
                    Hei @Model.FirstName 👋
                </h2>

                <p class="text-muted mb-0">
                    Velkommen tilbake til DugnadApp.
                    Her finner du en oversikt over dugnader, registrerte timer
                    og beskjeder fra styret.
                </p>

            </div>
        </div>
    </div>

    @if (Model.NesteDugnad != null)
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body">

                    <div class="mb-3">
                        <h5 class="card-title mb-0">
                            🌳 Neste fellesdugnad
                        </h5>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">
                            @Model.NesteDugnad.Tittel
                        </h5>

                        @if (Model.AntallRegistreringerPaAktivDugnad == 1)
                        {
                            <small class="text-success">
                                <i class="bi bi-check-circle"></i>
                                Mine registreringer: 1 gang
                            </small>
                        }
                        else if (Model.AntallRegistreringerPaAktivDugnad > 1)
                        {
                            <small class="text-success">
                                <i class="bi bi-check-circle"></i>
                                Mine registreringer: @Model.AntallRegistreringerPaAktivDugnad ganger
                            </small>
                        }
                    </div>

                    @if (Model.NesteDugnad.StartDato == Model.NesteDugnad.SluttDato)
                    {
                        <p class="mb-1">
                            <strong>Dato:</strong>
                            @Model.NesteDugnad.StartDato.ToString("dd.MM.yyyy")
                        </p>
                    }
                    else
                    {
                        <p class="mb-1">
                            <strong>Periode:</strong>
                            @Model.NesteDugnad.StartDato.ToString("dd.MM.yyyy")
                            –
                            @Model.NesteDugnad.SluttDato.ToString("dd.MM.yyyy")
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.NesteDugnad.Beskrivelse))
                    {
                        <p class="text-muted mt-3 mb-0">
                            @Model.NesteDugnad.Beskrivelse
                        </p>
                    }

                    <a asp-controller="Dugnadstimer"
                       asp-action="Create"
                       asp-route-dugnadId="@Model.NesteDugnad.Id"
                       class="btn btn-outline-primary btn-sm mt-3">
                        <i class="bi bi-arrow-right-circle me-1"></i>

                        @(Model.AntallRegistreringerPaAktivDugnad > 0
                            ? "Registrer flere timer"
                            : "Registrer timer")
                    </a>

                </div>
            </div>
        </div>
    }
    </div>

<div class="row g-4">

    <!-- Aktuelle oppgaver -->
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">

                <h5>
                    <i class="bi bi-list-check text-primary me-2"></i>
                    Oppgaver
                </h5>

                <hr />

                <h6 class="text-primary">Mine oppgaver</h6>

                @if (Model.MineOppgaver.Any())
                {
                    @foreach (var oppgave in Model.MineOppgaver)
                    {
                        <partial name="_OppgaveCard" model="oppgave" />
                    }
                }
                else
                {
                    <p class="text-muted">
                        Du er ikke påmeldt noen oppgaver.
                    </p>
                }

                <hr />

                <h6 class="text-success">Ledige oppgaver</h6>

                @if (Model.LedigeOppgaver.Any())
                {
                    @foreach (var oppgave in Model.LedigeOppgaver)
                    {
                        <partial name="_OppgaveCard" model="oppgave" />
                    }
                }
                else
                {
                    <p class="text-muted">
                        Ingen ledige oppgaver.
                    </p>
                }
                <!--
                @if (Model.TotalActiveTasks > 4)
                {
                    <a asp-controller="Oppgaver"
                       asp-action="Mine"
                       class="btn btn-outline-primary w-100 mt-3">
                        Vis alle oppgaver
                    </a>
                }
                -->
            </div>
        </div>
    </div>    

    <!-- Mine dugnadstimer -->
    <!-- Høyre kolonne -->
    <div class="col-12 col-lg-6">

        <div class="row g-4">

            <!-- Mine dugnadstimer -->
            <div class="col-12">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body">

                        <h5>
                            <i class="bi bi-clock-history text-success me-2"></i>
                            Mine dugnadstimer
                        </h5>

                        <hr />

                        <h1 class="display-4 text-primary">
                            @Model.TotalHours
                        </h1>

                        <p class="text-muted">
                            Registrerte timer i år
                        </p>

                        <div class="d-grid gap-2 d-md-flex">
                            <a asp-controller="Dugnadstimer"
                               asp-action="Index"
                               class="btn btn-outline-primary">
                                <i class="bi bi-clock-history me-1"></i>
                                Vis historikk
                            </a>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Beskjed fra styret -->
            @if (!string.IsNullOrWhiteSpace(Model.BoardMessage))
            {
                <div class="col-12">
                <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-body">
                            <h5>Beskjed fra styret</h5>

                            @Model.BoardMessage
                        </div>
                </div>
            </div>
            }
        </div>
    </div> 
</div>
</div>