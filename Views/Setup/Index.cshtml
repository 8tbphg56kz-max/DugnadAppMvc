@model DugnadAppMvc.Models.ViewModels.SetupViewModel

@{
    ViewData["Title"] = "Velkommen til DugnadApp";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

        <div class="card shadow-sm mt-4">
            <div class="card-body">

                <h2 class="card-title mb-3">
                    <i class="bi bi-house-heart-fill text-primary me-2"></i>
                    Velkommen til DugnadApp
                </h2>

                <p class="text-muted">
                    Dette ser ut til å være første gang DugnadApp brukes.
                    Opprett den første administratoren for å komme i gang.
                </p>

                <form asp-action="Index" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Fornavn" class="form-label"></label>
                        <input asp-for="Fornavn" class="form-control" />
                        <span asp-validation-for="Fornavn" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Etternavn" class="form-label"></label>
                        <input asp-for="Etternavn" class="form-control" />
                        <span asp-validation-for="Etternavn" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Epost" class="form-label"></label>
                        <input asp-for="Epost" class="form-control" />
                        <span asp-validation-for="Epost" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Leilighet" class="form-label"></label>
                        <input asp-for="Leilighet" class="form-control" />
                        <span asp-validation-for="Leilighet" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-person-plus-fill me-2"></i>
                            Opprett systemadministrator
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}