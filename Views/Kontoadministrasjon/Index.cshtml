@model KontoadministrasjonViewModel

@{
    ViewData["Title"] = "Ventende kontoaktivering";
}

<h2>Ventende kontoaktivering</h2>

@if (Model.VentendeKontoer.Any())
{
    <div class="card border-warning shadow-sm rounded-4 mb-4">
        <div class="card-header bg-warning-subtle">
            <h5 class="mb-0">
                <i class="bi bi-person-plus-fill me-2"></i>
                Disse brukerne har ennå ikke opprettet passord.
                Dersom en beboer har problemer med aktiveringen, kan en systemadministrator fullføre aktiveringen manuelt.
                <span class="badge bg-warning text-dark ms-2">
                    @Model.VentendeKontoer.Count
                </span>
            </h5>
        </div>

        <div class="list-group list-group-flush">

            @foreach (var bruker in Model.VentendeKontoer)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">

                    <div>
                        <strong>@bruker.FirstName @bruker.LastName</strong><br />
                        <span class="text-muted">@bruker.Email</span>
                    </div>

                    <form asp-action="Aktiver" method="post" class="d-inline">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@bruker.Id" />

                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bi bi-check-circle me-1"></i>
                            Fullfør aktivering
                        </button>
                    </form>

                    <form asp-action="SendNyAktiveringslenke"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@bruker.Id" />

                        <button class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-envelope me-1"></i>
                            Send ny lenke
                        </button>
                    </form>

                </div>
            }

        </div>
    </div>
}
else
{
    <div class="card border-success shadow-sm rounded-4">
        <div class="card-body text-center py-5">

            <i class="bi bi-check-circle-fill text-success display-4"></i>

            <h4 class="mt-3">
                Ingen kontoer venter på aktivering
            </h4>

            <p class="text-muted mb-0">
                Alle inviterte brukere har opprettet passord og kan logge inn.
            </p>

        </div>
    </div>
}