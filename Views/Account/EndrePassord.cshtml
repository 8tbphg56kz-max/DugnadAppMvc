@model DugnadAppMvc.ViewModels.EndrePassordViewModel

@{
    ViewData["Title"] = "Endre passord";
}

<div class="container-fluid px-2 px-md-4">

    <div class="row justify-content-center mt-4 mt-md-5">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white py-3">
                    <h2 class="h4 mb-0">
                        <i class="bi bi-key me-2"></i>
                        Endre passord
                    </h2>
                </div>

                <div class="card-body p-3 p-md-4">

                    <form asp-action="EndrePassord" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="GammeltPassord"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="GammeltPassord"
                                   class="form-control"
                                   autocomplete="current-password" />

                            <span asp-validation-for="GammeltPassord"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NyttPassord"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="NyttPassord"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NyttPassord"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BekreftPassord"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="BekreftPassord"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="BekreftPassord"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>
                                Endre passord
                            </button>

                            <a asp-action="MinKonto"
                               class="btn btn-outline-secondary">
                                Avbryt
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}