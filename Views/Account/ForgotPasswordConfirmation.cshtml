@{
    ViewData["Title"] = "Sjekk e-posten";
}

<div class="container mt-4">

    <div class="alert alert-success">

        <h3>Sjekk e-posten din</h3>

        <p>
            Hvis e-postadressen er registrert hos oss,
            har vi sendt deg en lenke for å velge nytt passord.
        </p>

        <p>
            Finner du ikke e-posten, sjekk søppelpost.
        </p>

        <a asp-action="Login"
           class="btn btn-primary">
            Tilbake til innlogging
        </a>

    </div>

</div>