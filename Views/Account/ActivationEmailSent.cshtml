@{
    ViewData["Title"] = "Aktiveringslenke sendt";
}

<div class="container mt-4">

    <div class="alert alert-success">

        <h3>Aktiveringslenke sendt</h3>

        <p>
            Hvis kontoen ikke allerede er aktivert, har vi sendt en aktiveringslenke til den registrerte e-postadressen.
        </p>

        <p>
            Åpne e-posten og klikk på Aktiver konto for å velge passord.
        </p>

        <p>
            Finner du ikke e-posten, sjekk også mappen for søppelpost.
        </p>

        <p>
            Hvis kontoen allerede er aktivert, kan du logge inn eller bruke Glemt passord dersom du ikke husker passordet.
        </p>

        <a asp-action="Login" class="btn btn-primary">
            Tilbake til innlogging
        </a>

    </div>

</div>