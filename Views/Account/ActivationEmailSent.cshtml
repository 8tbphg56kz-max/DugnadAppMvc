@{
    ViewData["Title"] = "Nesten ferdig!";
}

<div class="container mt-4">

    <div class="alert alert-success">

        <h3>Nesten ferdig!</h3>

        <p>
            Vi har sendt en aktiveringslenke til:
        </p>

        <p>
            <strong>@ViewBag.Email</strong>
        </p>

        <p>
            Åpne e-posten og klikk på lenken for å velge passord.
        </p>

        <p>
            Når passordet er valgt, blir du logget inn automatisk.
        </p>

        <p class="mb-0">
            Du kan lukke denne siden mens du venter på e-posten.
        </p>

    </div>

</div>