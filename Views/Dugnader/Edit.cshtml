@model DugnadAppMvc.Models.Dugnad

@{
    ViewData["Title"] = "Rediger dugnad";
}

<h2>Rediger dugnad</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Tittel" class="form-label"></label>
        <input asp-for="Tittel" class="form-control" />
        <span asp-validation-for="Tittel" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Beskrivelse" class="form-label"></label>
        <textarea asp-for="Beskrivelse" class="form-control" rows="4"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="StartDato" class="form-label"></label>
        <input asp-for="StartDato" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="SluttDato" class="form-label"></label>
        <input asp-for="SluttDato" type="date" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="KreverPamelding"
               class="form-check-input"
               id="HarPamelding" />
        <label asp-for="KreverPamelding" class="form-check-label">
            Krever påmelding
        </label>
    </div>

    <div class="mb-3">
        <label asp-for="MaksAntallDeltakere" class="form-label">
            Maks antall deltakere
        </label>

        <input asp-for="MaksAntallDeltakere"
               class="form-control"
               id="MaksAntallDeltakere" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="ErSynlig" class="form-check-input" />
        <label asp-for="ErSynlig" class="form-check-label">
            Synlig
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Lagre
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Avbryt
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function toggleMaxDeltakere() {

            const pamelding =
                document.getElementById("HarPamelding");

            const maks =
                document.getElementById("MaksAntallDeltakere");

            maks.disabled = !pamelding.checked;

            if (!pamelding.checked) {
                maks.value = "";
            }
        }

        document
            .getElementById("HarPamelding")
            .addEventListener("change", toggleMaxDeltakere);

        toggleMaxDeltakere();
    </script>
}