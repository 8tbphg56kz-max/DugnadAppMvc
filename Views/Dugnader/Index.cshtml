@model IEnumerable<DugnadAppMvc.Models.Dugnad>

@{
    ViewData["Title"] = "Fellesdugnader";
}

    @if (User.HasAdminAccess())
    {
        <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
            <h2>Fellesdugnader</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Ny fellesdugnad
        </a>
        </div>
    }

    @if (Model.Any())
{
<div class="table-responsive">

<table class="table table-striped">

    <thead>
        <tr>
            <th>Tittel</th>
            <th>Start</th>
            <th>Slutt</th>
            <th>Påmelding</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var dugnad in Model)
        {
            <tr>

                <td>@dugnad.Tittel</td>

                <td>
                    @dugnad.StartDato.ToString("dd.MM.yyyy")
                </td>

                <td>
                    @dugnad.SluttDato.ToString("dd.MM.yyyy")
                </td>

                <td>
                    @(dugnad.KreverPamelding ? "Ja" : "Nei")
                </td>
                <td>
                    @if (dugnad.ErSynlig)
                    {
                        <span class="badge bg-success">Synlig</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Skjult</span>
                    }
                </td>

                <td>

                    @if (User.HasAdminAccess())
                    {
                        <a asp-action="Edit"
                        asp-route-id="@dugnad.Id"
                        class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                    }

                    <form asp-action="ToggleVisible"
                          asp-route-id="@dugnad.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        @if (User.HasAdminAccess())
                            {
                                @if (dugnad.ErSynlig)
                                {
                                    <button type="submit"
                                    class="btn btn-sm btn-outline-warning"
                                    title="Skjul dugnad">
                                        <i class="bi bi-eye-slash"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                    class="btn btn-sm btn-outline-success"
                                    title="Vis dugnad">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                }
                            }
                        </form>

                    @if (User.HasAdminAccess())
                    {
                        <a asp-action="Delete"
                        asp-route-id="@dugnad.Id"
                        class="btn btn-sm btn-outline-danger"
                        title="Slett dugnad">
                            <i class="bi bi-trash"></i>
                        </a>
                    }
                </td>

            </tr>
        }

    </tbody>

</table>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 2.5rem;"></i>

            <h5 class="mt-3 mb-2">Ingen fellesdugnader</h5>

            <p class="text-muted mb-0">
                Det er ingen fellesdugnader registrert akkurat nå.
            </p>
        </div>
    </div>

}